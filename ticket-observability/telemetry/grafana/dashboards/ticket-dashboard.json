{
    "title": "Ticket Booking War Room",
    "uid": "ticket-war-room",
    "schemaVersion": 38,
    "refresh": "5s",
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "type": "timeseries",
        "title": "Tickets Booked (Total)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "expr": "tickets_booked_total",
            "legendFormat": "{{event_id}}",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          }
        ]
      },
      {
        "id": 2,
        "type": "timeseries",
        "title": "Request Rate (req/sec)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(rate(http_requests_total[1m]))",
            "legendFormat": "req/sec",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          }
        ]
      },
      {
        "id": 3,
        "type": "timeseries",
        "title": "Error Rate (%)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent"
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(rate(http_requests_total{status=~\"4..|5..\"}[1m])) / sum(rate(http_requests_total[1m])) * 100",
            "legendFormat": "error %",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          }
        ]
      },
      {
        "id": 4,
        "type": "timeseries",
        "title": "Latency P95 (ms)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ms"
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le)) * 1000",
            "legendFormat": "p95",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          }
        ]
      },
      {
        "id": 5,
        "type": "timeseries",
        "title": "Seats Currently Booked",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 16
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "expr": "seats_currently_booked",
            "legendFormat": "seats",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          }
        ]
      },
      {
        "id": 6,
        "type": "timeseries",
        "title": "Avg Booking Time (ms)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 16
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ms"
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "expr": "rate(booking_processing_seconds_sum[5m]) / rate(booking_processing_seconds_count[5m]) * 1000",
            "legendFormat": "avg",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          }
        ]
      },
      {
        "id": 7,
        "type": "timeseries",
        "title": "CPU Usage (%)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 24
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent"
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
            "legendFormat": "cpu",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          }
        ]
      },
      {
        "id": 8,
        "type": "timeseries",
        "title": "Memory Usage (%)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 24
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent"
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
            "legendFormat": "memory",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          }
        ]
      },
      {
        "id": 9,
        "type": "timeseries",
        "title": "Disk Usage (%)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 32
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent"
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "expr": "(1 - (node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})) * 100",
            "legendFormat": "disk",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          }
        ]
      },
      {
        "id": 10,
        "type": "timeseries",
        "title": "Network Receive (bytes/sec)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 32
        },
        "fieldConfig": {
          "defaults": {
            "unit": "Bps"
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "expr": "rate(node_network_receive_bytes_total[1m])",
            "legendFormat": "{{device}}",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          }
        ]
      }
    ]
  }